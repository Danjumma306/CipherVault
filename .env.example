# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL Connection (Cloud SQL Unix socket or local TCP localhost)
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="ciphervault"
SQL_USER="postgres"
SQL_PASSWORD="YOUR_POSTGRES_PASSWORD"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="YOUR_POSTGRES_ADMIN_PASSWORD"

# Administrator Configuration (used exclusively via the obscured operator auth gate)
ADMIN_EMAIL="osmanp999@gmail.com"
# Optional: Set a strong passkey for local/offline operator login without Google Sign-In
ADMIN_PASSKEY=""

# Outbound SMTP Mailer (100% Free via Gmail App Password — up to 500 emails/day, no card needed)
# Create a 16-char App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="osmanp999@gmail.com"
SMTP_PASS="YOUR_16_CHAR_GMAIL_APP_PASSWORD"
SMTP_FROM="CipherVault <osmanp999@gmail.com>"
#
# Alternative free-tier transactional providers:
#   Brevo (Free plan, 300/day): SMTP_HOST="smtp-relay.brevo.com" | SMTP_PORT="587" | SMTP_SECURE="false"
#   Resend (Free tier):           SMTP_HOST="smtp.resend.com"      | SMTP_PORT="465" | SMTP_SECURE="true" | SMTP_USER="resend"

# JWT_SECRET: 256-bit (64 hex chars) secret key used to sign and verify JWT bearer tokens.
JWT_SECRET="REPLACE_WITH_64_HEX_CHARACTER_SECRET"

# VAULT_MASTER_KEY: 32-byte (64 hex chars) AES-256-GCM master encryption key for files at rest.
VAULT_MASTER_KEY="REPLACE_WITH_64_HEX_CHARACTER_KEY"
